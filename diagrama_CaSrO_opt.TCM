@@ =========================================================================
@@ diagrama_CaSrO_opt.TCM
@@ Calculation and plotting of the CaO-SrO pseudobinary diagram
@@ using the optimized database CaSrO_opt.tdb
@@
@@ How to run it in Thermo-Calc (Console Mode):
@@   1. File -> Set Working Directory... -> select the project folder
@@   2. macro_file_open diagrama_CaSrO_opt.TCM
@@ =========================================================================

set-echo

@@ -------------------------------------------------------------------------
@@ BLOCK 1 - Loading the optimized database
@@ -------------------------------------------------------------------------
go data
switch-database USER CaSrO_opt.tdb
define-system CA SR O
get-data
list-system constituent

@&

@@ -------------------------------------------------------------------------
@@ BLOCK 2 - Setting up the CaO-SrO pseudobinary section (X(O) = 0.5)
@@           X(SR) runs from 0 (pure CaO) to 0.5 (pure SrO).
@@           It starts at 1100 K and X(SR) = 0.2 (inside the gap) so that
@@           global minimization creates the two halite composition sets.
@@ -------------------------------------------------------------------------
go poly_3
change-status phase BCC_A2 FCC_A1 CAO2 SRO2 GAS = suspended
set-condition P=101325 N=1 X(O)=0.5 X(SR)=0.2 T=1100
compute-equilibrium
list-equilibrium ,,,,

@&

@@ -------------------------------------------------------------------------
@@ BLOCK 3 - Mapping the phase diagram
@@           Axis 1: X(SR) from 0 to 0.5 (atomic fraction of Sr)
@@           Axis 2: temperature T from 300 K to 3400 K (from room
@@           temperature upwards)
@@ -------------------------------------------------------------------------
set-axis-variable 1 X(SR) 0 0.5,,,
set-axis-variable 2 T 300 3400,,,
save CaSrO_opt_diag Y
map

@&

@@ -------------------------------------------------------------------------
@@ BLOCK 4 - Plotting and displaying the diagram
@@ -------------------------------------------------------------------------
post
set-diagram-axis x X(SR)
set-diagram-axis y T
set-title CaO-SrO Pseudobinary Diagram (PARROT Optimized),,
plot

set-inter
