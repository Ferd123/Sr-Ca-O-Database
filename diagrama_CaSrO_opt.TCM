@@ =========================================================================
@@ diagrama_CaSrO_opt.TCM
@@ Calculo y trazado del diagrama pseudobinario CaO-SrO
@@ utilizando la base de datos optimizada CaSrO_opt.tdb
@@
@@ Instrucciones de ejecucion en Thermo-Calc (Console Mode):
@@   1. File -> Set Working Directory... -> seleccionar la carpeta del proyecto
@@   2. macro_file_open diagrama_CaSrO_opt.TCM
@@ =========================================================================

set-echo

@@ -------------------------------------------------------------------------
@@ BLOQUE 1 - Carga de la base de datos optimizada
@@ -------------------------------------------------------------------------
go data
switch-database USER CaSrO_opt.tdb
define-system CA SR O
get-data
list-system constituent

@&

@@ -------------------------------------------------------------------------
@@ BLOQUE 2 - Configuracion del corte pseudobinario CaO-SrO (X(O) = 0.5)
@@            X(SR) varia de 0 (CaO puro) a 0.5 (SrO puro).
@@            Se inicia a 1100 K y X(SR) = 0.2 (dentro de la laguna)
@@            para que la minimizacion global cree las dos halitas.
@@ -------------------------------------------------------------------------
go poly_3
change-status phase BCC_A2 FCC_A1 CAO2 SRO2 GAS = suspended
set-condition P=101325 N=1 X(O)=0.5 X(SR)=0.2 T=1100
compute-equilibrium
list-equilibrium ,,,,

@&

@@ -------------------------------------------------------------------------
@@ BLOQUE 3 - Mapeo del diagrama de fases
@@            Eje 1: X(SR) de 0 a 0.5 (fraccion atómica de Sr)
@@            Eje 2: Temperatura T de 300 K a 3400 K (desde temperatura ambiente)
@@ -------------------------------------------------------------------------
set-axis-variable 1 X(SR) 0 0.5,,,
set-axis-variable 2 T 300 3400,,,
save CaSrO_opt_diag Y
map

@&

@@ -------------------------------------------------------------------------
@@ BLOQUE 4 - Graficacion y desplegado del diagrama
@@ -------------------------------------------------------------------------
post
set-diagram-axis x X(SR)
set-diagram-axis y T
set-title Diagrama Pseudobinario CaO-SrO (Optimizado PARROT),,
plot

set-inter
