@@ =========================================================================
@@ validar_CaSrO.TCM  -  validation of CaSrO.TDB in Console Mode
@@
@@ IMPORTANT: the folder "TDB 1" has a SPACE in its name, and the Console
@@ Mode command SWITCH_DATABASE does not accept quoted paths. That is why
@@ the macro uses the bare file name, and it must be run with the project
@@ folder as the working directory:
@@
@@   Console Mode -> File menu -> Set Working Directory... -> "TDB 1"
@@   then:  macro_file_open validar_CaSrO.TCM
@@
@@ Syntax checked against the example macros shipped with Thermo-Calc
@@ 2025a (Examples\Console-Mode\Thermo-Calc) and against the Database
@@ Manager User Guide of the Documentation Set.
@@ =========================================================================

set-echo

@@ -------------------------------------------------------------------------
@@ BLOCK 1 - loading the database
@@ If there is a syntax error in the TDB it fails here and Thermo-Calc
@@ points to the line. LIST-SYSTEM CONSTITUENT must show 7 phases:
@@ LIQUID, HALITE, CAO2, SRO2, FCC_A1, BCC_A2, GAS
@@ -------------------------------------------------------------------------
go da
sw user CaSrO.TDB
def-sys ca sr o
get-data
list-system constituent

@&

@@ -------------------------------------------------------------------------
@@ BLOCK 2 - congruent melting of CaO.   EXPECTED: 3222.0 K
@@ GAS is suspended because it is incomplete (see NOTE 6 of the TDB).
@@ With 3 components 5 conditions are needed: P, N, x(SR), x(O), T.
@@ -------------------------------------------------------------------------
go p-3
c-st p gas=sus
s-c p=1e5 n=1 x(sr)=0 x(o)=0.5 t=3200
c-e
c-st p liquid=fix 0
s-c t=none
c-e
l-e,,,,

@&

@@ -------------------------------------------------------------------------
@@ BLOCK 3 - congruent melting of SrO.   EXPECTED: 2870.5 K
@@ -------------------------------------------------------------------------
c-st p liquid=ent 1
s-c t=2800 x(sr)=0.5 x(o)=0.5
c-e
c-st p liquid=fix 0
s-c t=none
c-e
l-e,,,,

@&

@@ -------------------------------------------------------------------------
@@ BLOCK 4 - Ca-O phase diagram  (x(SR) = 0, GAS suspended)
@@ CHECK: bcc-Ca + CaO eutectic near 1094 K and 1.7 at.% O, and melting of
@@ CaO at 3222 K.
@@ -------------------------------------------------------------------------
c-st p liquid=ent 1
s-c p=1e5 n=1 x(sr)=0 x(o)=0.3 t=2000
c-e
s-a-v 1 x(o) 0 1,,,
s-a-v 2 t 800 3600,,,
save CaO_diag y
map
post
s-d-a x x(o)
s-d-a y t
set-title Ca-O calculated with CaSrO.TDB,,
plot

@&

@@ -------------------------------------------------------------------------
@@ BLOCK 5 - CaO-SrO pseudobinary   (x(O) = 0.5 fixed)
@@ In this section x(SR) runs from 0 (pure CaO) to 0.5 (pure SrO), and the
@@ SrO fraction in the halite is  x_SrO = 2*x(SR).
@@
@@ The starting point is placed INSIDE the miscibility gap (1100 K,
@@ x(SR) = 0.2, that is x_SrO = 0.4) so that global minimization creates
@@ the second halite composition set by itself.
@@
@@ CHECK: gap at 1100 K between x(SR) = 0.116 and 0.348
@@        (that is x_SrO = 0.232 and 0.696; experimental 0.240 and 0.710),
@@        closure of the gap near 1180 K,
@@        liquidus between 2870 K (SrO) and 3222 K (CaO).
@@ -------------------------------------------------------------------------
go p-3
s-c p=1e5 n=1 x(o)=0.5 x(sr)=0.2 t=1100
c-e
l-e,,,,
s-a-v 1 x(sr) 0 0.5,,,
s-a-v 2 t 800 3400,,,
save CaOSrO_diag y
map
post
s-d-a x x(sr)
s-d-a y t
set-title CaO-SrO pseudobinary,,
plot

@&

@@ -------------------------------------------------------------------------
@@ BLOCK 6 - metallic Ca-Sr binary   (no oxygen)
@@ CHECK: continuous fcc and bcc solid solutions, melting of Ca at 1115 K
@@ and of Sr at 1050 K, no intermediate phases.
@@ -------------------------------------------------------------------------
go p-3
c-st p *=ent 1
c-st p gas=sus
c-st p halite cao2 sro2=sus
s-c p=1e5 n=1 x(o)=0 x(sr)=0.3 t=1000
c-e
s-a-v 1 x(sr) 0 1,,,
s-a-v 2 t 300 1300,,,
save CaSr_diag y
map
post
s-d-a x x(sr)
s-d-a y t
set-title Metallic Ca-Sr binary,,
plot

@&

@@ -------------------------------------------------------------------------
@@ BLOCK 7 - stability of the peroxides against pO2
@@ Decomposition CaO2 -> CaO + O2. [1] computes it at 163 K and 1 bar.
@@ Here the decomposition temperature is traced against log10(pO2).
@@ -------------------------------------------------------------------------
go p-3
c-st p *=ent 1
c-st p liquid halite sro2 fcc_a1 bcc_a2=sus
c-st p cao2 gas=ent 1
s-c p=1e5 n=1 x(sr)=0 x(o)=0.7 t=200
c-e
l-e,,,,

@&
set-inter

@@ =========================================================================
@@ Notes
@@
@@ - If Thermo-Calc complains about an exact x = 0 in blocks 2, 3, 4 or 6,
@@   replace the zero with 1e-6; the result does not move appreciably.
@@ - The files CaO_diag.POLY3, CaOSrO_diag.POLY3 and CaSr_diag.POLY3 are
@@   saved in the working directory; they can be reopened with
@@   READ_WORKSPACES without recomputing the MAP.
@@ - SAVE before MAP is mandatory: MAP writes over the workspace.
@@ =========================================================================
