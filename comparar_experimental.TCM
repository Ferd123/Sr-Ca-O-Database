@@ =========================================================================
@@ comparar_experimental.TCM
@@ Compares CaSrO.TDB against the experimental data from the literature.
@@
@@ Requires in the SAME working directory:
@@     CaSrO.TDB
@@     experimental_CaSrO.EXP
@@
@@ Console Mode -> File -> Set Working Directory... -> project folder
@@ then:  macro_file_open comparar_experimental.TCM
@@
@@ The blocks are separated by @& so they can be run one at a time.
@@ =========================================================================

set-echo

@@ -------------------------------------------------------------------------
@@ BLOCK 1 - loading
@@ -------------------------------------------------------------------------
go da
sw user CaSrO.TDB
def-sys ca sr o
get-data

@&

@@ -------------------------------------------------------------------------
@@ BLOCK 2 - Ca-CaO liquidus point by point, NUMERICAL comparison
@@
@@ The solubility of CaO in saturated liquid Ca is computed at the
@@ temperatures where Fischbach measurements exist. Read X(LIQUID,O) in
@@ each output and compare with the right-hand column.
@@
@@   T(K)    calculated   Fischbach (Fig.3 of [1])
@@   1233      0.0237     0.026
@@   1350      0.0299     0.029   (interpolated between 1307 and 1372)
@@   1470      0.0375     0.033 and 0.039  (two points)
@@   1575      0.0453     0.042
@@   1710      0.0573     0.058 and 0.062  (two points)
@@
@@ Expected agreement: within 0.2-0.5 at.% O over the whole range.
@@ -------------------------------------------------------------------------
go p-3
c-st p gas=sus
c-st p halite=fix 1
s-c p=1e5 n=1 x(sr)=0 t=1233
c-e
show x(liquid,o)

s-c t=1350
c-e
show x(liquid,o)

s-c t=1470
c-e
show x(liquid,o)

s-c t=1575
c-e
show x(liquid,o)

s-c t=1710
c-e
show x(liquid,o)

@&

@@ -------------------------------------------------------------------------
@@ BLOCK 3 - activity of Ca in the CaO-saturated liquid
@@ Reference: pure liquid Ca at the same temperature.
@@
@@   T(K)    calculated   Zaitsev
@@   1273      0.974      0.985
@@   1473      0.962      0.963
@@   1673      0.946      0.931
@@
@@ Note: the calculated trend crosses the experimental one near 1470 K.
@@ This follows directly from having fitted the Fischbach solubilities
@@ and not the Zaitsev activities; the two sets are mutually
@@ incompatible and [1] chose the former. See section 2.5 of [1].
@@ -------------------------------------------------------------------------
s-r-s liquid ca
s-c t=1273
c-e
show acr(ca,liquid)
s-c t=1473
c-e
show acr(ca,liquid)
s-c t=1673
c-e
show acr(ca,liquid)

@&

@@ -------------------------------------------------------------------------
@@ BLOCK 4 - Ca-CaO diagram with the experimental points overlaid
@@ Datasets 1 and 2 = Fischbach (accepted)
@@ Datasets 3 and 4 = Zaitsev and Bevan (discarded by [1], for contrast)
@@ -------------------------------------------------------------------------
go p-3
c-st p *=ent 1
c-st p gas=sus
s-c p=1e5 n=1 x(sr)=0 x(o)=0.03 t=1400
c-e
s-a-v 1 x(o) 0 0.16,,,
s-a-v 2 t 1000 1800,,,
save comp_CaO y
map
post
s-d-a x x(o)
s-d-a y t
set-ax-ty x n
set-scaling x n 0 0.16
set-scaling y n 1000 1800
@@ the X axis of the EXP file is in AT.% O, so it has to be rescaled or
@@ the diagram axis changed to percent. Here the diagram is changed:
s-d-a x x%(o)
set-scaling x n 0 16
append-exp y experimental_CaSrO 0 1 2 3 4
set-title Liquidus Ca-CaO vs experimental,,
plot

@&

@@ -------------------------------------------------------------------------
@@ BLOCK 5 - CaO-SrO pseudobinary with the experimental gap of Jacob
@@ Dataset 5. Expected: the two Jacob points (x(Sr) = 0.120 and 0.356 at
@@ 1100 K) should fall almost on top of the calculated branches, which
@@ give 0.116 and 0.348.
@@ -------------------------------------------------------------------------
go p-3
c-st p *=ent 1
c-st p gas=sus
s-c p=1e5 n=1 x(o)=0.5 x(sr)=0.2 t=1100
c-e
s-a-v 1 x(sr) 0 0.5,,,
s-a-v 2 t 800 3400,,,
save comp_CaOSrO y
map
post
s-d-a x x(sr)
s-d-a y t
append-exp y experimental_CaSrO 0 5
set-title CaO-SrO vs experimental gap of Jacob,,
plot

@&

@@ -------------------------------------------------------------------------
@@ BLOCK 6 - Gibbs energy of formation of SrO(s)
@@ Reaction: Sr(fcc) + 1/2 O2(g) = SrO(s)
@@
@@   T(K)    calculated (kJ/mol)  Fig.4 of Risold 1996
@@   1373         -452.6                 ~ -453
@@   1573         -432.8                 ~ -433
@@   1773         -413.1                 ~ -413
@@
@@ The Ono points lie below the curve at low temperature and converge
@@ towards it as it rises; that is how they appear in the paper figure.
@@
@@ NOTE: the dfG(SrO) values in datos_experimentales_parrot.md (-479.2 at
@@ 1373 K) are WRONG, some 26 kJ/mol too negative.
@@ -------------------------------------------------------------------------
go p-3
c-st p *=sus
c-st p halite=ent 1
s-c p=1e5 n=1 x(ca)=0 t=1373
c-e
show gm(halite)

@&

@@ -------------------------------------------------------------------------
@@ BLOCK 7 - enthalpy of mixing of the halite at 298 K
@@ Dataset 6 (Flidlider, unverified).
@@
@@   x(Sr)   calculated (J/mol)  Flidlider (approx)
@@   0.050        2160                1800
@@   0.125        4420                3700
@@   0.250        5750                5000
@@   0.375        4200                3600
@@   0.450        1980                1600
@@
@@ The database sits systematically 15-20 % high. That is consistent: the
@@ halite parameter was fitted to the Jacob tie-lines, not to the
@@ Flidlider calorimetry. If the enthalpy matters more than the gap,
@@ there is room for reoptimization here.
@@ -------------------------------------------------------------------------
go p-3
c-st p *=sus
c-st p halite=ent 1
s-c p=1e5 n=1 x(o)=0.5 x(sr)=0.25 t=298.15
c-e
show hm(halite)

@&
set-inter

@@ =========================================================================
@@ Notes
@@
@@ - APPEND-EXP: if Console Mode does not accept the dataset numbers
@@   inline, run the command without arguments and answer the prompts:
@@       APPEND_EXPERIMENTAL_DATA
@@       Use experimental data:  Y
@@       Data file name:         experimental_CaSrO
@@       Prologue number:        0
@@       Datasets:               1 2 3 4
@@
@@ - The X axis of the EXP file for the liquidus is in AT.% O (0 to 16),
@@   not in mole fraction. That is why block 4 changes the diagram axis to
@@   X%(O). For mole fraction, divide the values of datasets 1 to 4 by
@@   100.
@@
@@ - Dataset 6 (enthalpy) is in J/mol against x(Sr); it does not overlay
@@   any phase diagram, it needs its own H vs x plot.
@@ =========================================================================
